# Exemplo de configuração para desenvolvimento local.
# Copie este arquivo para application-dev.properties e ajuste os valores.
# Este arquivo é uma referência opcional para customizar a configuração dev.

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/onlystudent}
spring.datasource.username=${DB_USERNAME:onlystudent}
spring.datasource.password=${DB_PASSWORD:onlystudent-local-dev}

spring.jpa.show-sql=true
logging.level.org.hibernate.SQL=DEBUG

api.security.token.security=${JWT_SECRET}
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:3000}
